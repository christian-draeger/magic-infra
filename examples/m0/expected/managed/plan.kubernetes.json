{
  "applicationId": "shop",
  "artifacts": [
    {
      "kind": "kubernetes-manifest",
      "path": "kubernetes.yaml"
    }
  ],
  "diagnostics": [
    {
      "code": "SPRING-CONFIG-PLACEHOLDER",
      "message": "Datasource URL is provided as a runtime reference; ownership must be declared explicitly.",
      "severity": "warning",
      "source": {
        "kind": "spring-property",
        "path": "src/main/resources/application.yaml",
        "reference": "spring.datasource.url"
      }
    }
  ],
  "limitations": [
    "Compilation preview only."
  ],
  "mode": "compile-preview",
  "operations": [
    {
      "action": "create",
      "description": "Resolve PostgreSQL ownership.",
      "id": "create-primary-db",
      "requiresApproval": false,
      "resourceId": "primary-db",
      "risk": "moderate"
    },
    {
      "action": "bind",
      "description": "Wire the application to PostgreSQL.",
      "id": "bind-api",
      "requiresApproval": false,
      "resourceId": "api",
      "risk": "low"
    }
  ],
  "prerequisites": [
    {
      "description": "Provide the prebuilt application image.",
      "id": "oci-image",
      "required": true
    },
    {
      "description": "Provide the referenced Kubernetes Secret.",
      "id": "credentials",
      "required": true
    },
    {
      "description": "Install CloudNativePG and configure compatible storage.",
      "id": "cloudnativepg",
      "required": true
    }
  ],
  "schemaVersion": "plan/v1alpha1",
  "target": {
    "backend": "kubernetes",
    "environment": "dev"
  }
}
