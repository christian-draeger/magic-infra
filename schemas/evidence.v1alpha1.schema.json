{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-infra:schema:evidence:v1alpha1",
  "title": "magic-infra Evidence v1alpha1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "evidence/v1alpha1"
    },
    "adapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rulesVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "rulesVersion"
      ],
      "additionalProperties": false
    },
    "application": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "enum": [
            "java",
            "kotlin",
            "typescript",
            "javascript",
            "other"
          ]
        },
        "frameworkVersion": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "framework",
        "language"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environmentScope": {
          "type": "string",
          "enum": [
            "local-supported",
            "explicit-snapshot",
            "other"
          ]
        }
      },
      "required": [
        "profiles",
        "limitations",
        "environmentScope"
      ],
      "additionalProperties": false
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "buildSystem": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "module",
          "buildSystem"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^f-[a-z0-9-]+$"
          },
          "serviceId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "dependency",
              "configuration",
              "annotation",
              "bean",
              "declaration"
            ]
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "implementation": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "gradle",
                  "spring-property",
                  "bytecode",
                  "infra-declaration",
                  "other"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "kind",
              "reference"
            ],
            "additionalProperties": false
          },
          "certainty": {
            "type": "string",
            "enum": [
              "observed",
              "uncertain"
            ]
          },
          "details": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "annotation": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "serviceId",
          "kind",
          "capability",
          "source",
          "certainty"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "gradle",
                  "spring-property",
                  "bytecode",
                  "infra-declaration",
                  "other"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "kind",
              "reference"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "adapter",
    "application",
    "analysis",
    "services",
    "findings",
    "diagnostics"
  ],
  "additionalProperties": false
}
