{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-infra:schema:plan:v1alpha1",
  "title": "magic-infra Deployment Plan v1alpha1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "plan/v1alpha1"
    },
    "applicationId": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "docker-compose",
            "kubernetes"
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "backend",
        "environment"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "compile-preview",
        "state-aware-diff"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "resourceId": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "reference",
              "bind",
              "retain",
              "detach",
              "require",
              "no-op"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high",
              "destructive"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requiresApproval": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "resourceId",
          "action",
          "risk",
          "description",
          "requiresApproval"
        ],
        "additionalProperties": false
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "description",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!(?:[^/]+/)*\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "gradle",
                  "spring-property",
                  "bytecode",
                  "infra-declaration",
                  "other"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "kind",
              "reference"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "applicationId",
    "target",
    "mode",
    "operations",
    "prerequisites",
    "artifacts",
    "diagnostics",
    "limitations"
  ],
  "additionalProperties": false
}
